<nav id="navbar" class="<%= typeof navClass !== 'undefined' ? navClass : 'fixed top-0 left-0 right-0 z-50 transition-all duration-300 text-white' %>">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-20">
        <a href="./" class="<%= typeof logoClass !== 'undefined' ? logoClass : 'p-2 bg-white/80 w-[180px] hover:opacity-80 transition-opacity flex items-center rounded-lg' %>">
          <% if (WEBSITE_LOGO && WEBSITE_LOGO.enabled && WEBSITE_LOGO.src) { %>
            <img src="<%= WEBSITE_LOGO.src %>" alt="<%= WEBSITE_NAV_BRAND %>"
              width="<%= WEBSITE_LOGO.width || '180px' %>" class="block h-auto">
            <% } else { %>
              <span class="text-2xl font-bold tracking-tight">
                <%= WEBSITE_NAV_BRAND %>
              </span>
              <% } %>
        </a>
        <div class="flex items-center space-x-4">
          <!-- Navigation Menu Button -->
          <button id="mobile-menu-btn"
            class="<%= typeof btnClass !== 'undefined' ? btnClass : 'flex items-center space-x-2 px-3 py-2 rounded-lg text-white hover:bg-white/10 transition-all duration-300 group' %>">
            <span class="<%= typeof btnTextClass !== 'undefined' ? btnTextClass : 'text-sm font-bold tracking-widest uppercase opacity-80 group-hover:opacity-100' %>">MENU</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 <%= typeof iconClass !== 'undefined' ? iconClass : '' %>" fill="none" viewBox="0 0 24 24"
              stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= typeof iconWidth !== 'undefined' ? iconWidth : '2' %>" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>
</nav>
