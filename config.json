      { "text": "旅行", "url": "/travel/" }
    ],
    "pages": [
      {
        "name": "index",
        "template": "index.html",
        "output": "index.html",
        "fontOutput": "assets/fonts/index/",
        "data": {}
      },
      {
        "name": "travel",
        "template": "travel/index.html",
        "output": "travel/index.html",
        "fontOutput": "assets/fonts/travel/",
        "data": {
          "TITLE": "旅行",
