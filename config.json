      "enabled": true,
      "src": "/assets/logo.svg",
      "width": "180px"
    },
    "photosDir": "../photography",
    "template": "magazine",
    "supportedExtensions": [".jpg", ".jpeg", ".png", ".webp"],
    "thumbnail": {
      "width": 800,
      "height": 800,
      "quality": 80,
      "fit": "inside"
    },
    "large": {
      "maxSize": 3000,
      "quality": 60,
      "fit": "inside"
    }
  },
  "site": {
    "nav": [
      { "text": "首页", "url": "/" },
      { "text": "随笔", "url": "/blog/" },
      { "text": "摄影", "url": "/photography/" },
