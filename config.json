{
  "common": {
    "site": {
      "title": "IMCOLIN.FAN",
      "description": "",
      "url": "imcolin.fan",
      "font": {
        "name": "KingHwaOldSong",
        "source": "templates/assets/fonts/京華老宋体v3.0.ttf"
      }
    },
    "defaultAuthor": "Fan Kangsong"
  },
  "gallery": {
    "navBrand": "COLIN PHOTO",
    "brandDescription": "摄影于我的意义是回忆和美。",
    "logo": {
      "enabled": true,
      "src": "/assets/logo.svg",
      "width": "180px"
    },
    "photosDir": "../photography",
    "template": "magazine",
    "supportedExtensions": [".jpg", ".jpeg", ".png", ".webp"],
    "thumbnail": {
      "width": 800,
      "height": 800,
      "quality": 80,
      "fit": "inside"
    },
    "large": {
      "maxSize": 3000,
      "quality": 60,
      "fit": "inside"
    },
    "concurrency": 4
  },
  "pictures": {
    "sourceDir": "../daughter-pictures",
    "supportedExtensions": [".jpg", ".jpeg", ".png", ".webp"],
    "thumbnail": {
      "width": 800,
      "height": 800,
      "quality": 80,
      "fit": "inside"
    },
    "concurrency": 4
  },
  "timeline": {
    "sourceDir": "data-source/timeline/org",
    "outputFile": "data-source/timeline.json",
    "supportedExtensions": [".jpg", ".jpeg", ".png", ".webp"]
  },
  "site": {
    "nav": [
      { "text": "首页", "url": "/" },
      { "text": "随笔", "url": "/blog/" },
      { "text": "摄影", "url": "/photography/" },
      { "text": "跑步", "url": "/running/" },
      { "text": "旅行", "url": "/travel/" },
      { "text": "香香的画", "url": "/pictures/" },
      { "text": "关于", "url": "/about/" }
    ],
    "pages": [
      {
        "name": "index",
        "template": "index.html",
        "output": "index.html",
        "fontOutput": "assets/fonts/index/",
        "dataFile": "data-source/timeline.json",
        "publish": [
          { "from": "data-source/timeline/demo", "to": "assets/timeline/demo" },
          {
            "from": "data-source/timeline/org",
            "to": "assets/timeline/org",
            "ext": [".jpg", ".jpeg", ".png", ".webp"]
          }
        ],
        "data": {
          "TITLE": "IMCOLIN.FAN · 记录",
          "DESCRIPTION": "时间轴 · 记录",
          "HINT": "上下滚动或拖动，点击日期查看记录",
          "UI_TEXT": "年月日放大照片：未命名照片本记录共张照片，鼠标移入后左右移动可逐张抽出，点击放大在高德地图中查看查看的记录首页数据解析失败不是合法 JSON，修正后重新构建首页还没有记录在里补上记录后重新构建"
        }
      },
      {
        "name": "about",
        "template": "about.html",
        "output": "about/index.html",
        "fontOutput": "assets/fonts/about/",
        "data": { "TITLE": "关于", "DESCRIPTION": "关于 Colin" }
      },
      {
        "name": "travel",
        "template": "travel/index.html",
        "output": "travel/index.html",
        "fontOutput": "assets/fonts/travel/",
        "data": {
          "TITLE": "旅行",
          "DESCRIPTION": "Travel Map"
        }
      },
      {
        "name": "404",
        "template": "404.html",
        "output": "404.html",
        "fontOutput": "assets/fonts/error/",
        "data": {
          "TITLE": "404 - Page Not Found",
          "DESCRIPTION": "Page not found"
        }
      }
    ],
    "blog": {
      "dir": "../blog-post",
      "template": "blog/post",
      "indexTemplate": "blog/index",
      "title": "随笔",
      "description": "随笔"
    },
    "travel": {
      "kmlUrl": "https://www.google.com/maps/d/kml?forcekml=1&mid=1ITNU4y9FSrODmHp-Kt6CTbt7uA0",
      "snapshotPath": "data-source/travel.kml",
      "outputPath": "assets/travel/markers.json"
    }
  }
}
